# Copy to .env.local for host-only overrides. start-backend.ps1 loads it after .env.
# The portable runtime on this PC uses 15432 / 17687; standard installations may differ.
DB_URL=jdbc:postgresql://127.0.0.1:15432/brain
DB_USER=brain
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
LOCAL_JEV_URL=http://127.0.0.1:8017/v1/systemone
HERMES_PUBLISH_MODE=filesystem
DB_PASSWORD=brain_demo_only
NEO4J_PASSWORD=neo4j_demo_only

# Anonymous access is disabled by default. See docs/DEMO_ACCESS_SETUP.md.
DEMO_ACCESS_ENABLED=false
DEMO_ACCESS_EXPIRES_AT=
