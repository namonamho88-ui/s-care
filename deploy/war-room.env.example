# OFF by default. Apply backend and frontend configuration together.
# Generate a NEW random >=32-character key; never use ADMIN_TOKEN here.

# Railway backend (single instance)
WAR_ROOM_ENABLED=false
WAR_ROOM_GATEWAY_KEY=
WAR_ROOM_ALLOWED_ORIGINS=https://s-care-mu.vercel.app

# Vercel frontend server environment (same enabled/key values)
# WAR_ROOM_ENABLED=false
# WAR_ROOM_GATEWAY_KEY=
# WAR_ROOM_WS_URL=wss://<verified-railway-backend>/api/war-room/socket
# BACKEND_URL=https://<verified-railway-backend>

# No NEXT_PUBLIC secrets. No browser database credentials. No WS proxy on Vercel.
