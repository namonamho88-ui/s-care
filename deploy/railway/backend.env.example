# Root directory /backend; detected Dockerfile; one always-on replica.
# Public HTTPS domain targets PORT. A2A/MCP loopback follows PORT automatically.
PORT=8080
SPRING_PROFILES_ACTIVE=cloud
ADMIN_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARS
DB_URL=jdbc:postgresql://YOUR-SESSION-POOLER.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_SCHEMA=brain
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=1
NEO4J_URI=bolt://neo4j.railway.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j
GRAPH_REQUIRED=true
AGENT_BASE_URL=https://YOUR-BACKEND.up.railway.app
JEV_PROVIDER=LOCAL
LOCAL_JEV_URL=http://jevos.railway.internal:8017/v1/systemone
LOCAL_JEV_KEY=REPLACE_WITH_LOCAL_JEV_KEY
HERMES_URL=http://hermes.railway.internal:8642/v1
HERMES_API_KEY=REPLACE_WITH_HERMES_API_KEY
HERMES_PUBLISH_MODE=http
HERMES_PUBLISH_URL=http://hermes.railway.internal:8643
HERMES_PUBLISH_KEY=REPLACE_WITH_SEPARATE_RANDOM_PUBLISH_KEY
SSE_TIMEOUT_MS=240000
# Later: TYPESAFE_API_KEY=... . Do not provide OPENAI_API_KEY to this service.

# Anonymous access is disabled by default. See docs/DEMO_ACCESS_SETUP.md.
DEMO_ACCESS_ENABLED=false
DEMO_ACCESS_EXPIRES_AT=
