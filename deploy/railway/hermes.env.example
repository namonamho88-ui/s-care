# Root directory /; Dockerfile path infra/hermes/Dockerfile.
# Mount a persistent volume at /data/hermes. No public domain is needed.
RAILWAY_DOCKERFILE_PATH=infra/hermes/Dockerfile
PORT=8642
HERMES_API_KEY=REPLACE_WITH_HERMES_API_KEY
HERMES_PUBLISH_KEY=REPLACE_WITH_SEPARATE_RANDOM_PUBLISH_KEY
HERMES_PUBLISH_HOST=0.0.0.0
HERMES_PUBLISH_PORT=8643
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
HERMES_LLM_MODEL=gpt-4.1-mini
