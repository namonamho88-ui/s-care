# Official image neo4j:5.26-community; persistent volume /data, private network only.
# Keep the database available; generic serverless sleep is not recommended for databases.
# Do not shrink memory limits or remove the volume to reduce cost.
PORT=7474
NEO4J_AUTH=neo4j/REPLACE_WITH_NEO4J_PASSWORD
NEO4J_server_memory_heap_initial__size=256m
NEO4J_server_memory_heap_max__size=512m
NEO4J_server_memory_pagecache_size=128m
# dbms.usage_report.enabled=false: disable outbound anonymous usage reports.
NEO4J_dbms_usage__report_enabled=false
# Small demo volumes: avoid reserving 256 MiB of transaction logs per database.
NEO4J_db_tx__log_preallocate=false
NEO4J_db_tx__log_rotation_size=16M
NEO4J_db_tx__log_rotation_retention__policy=2 files
