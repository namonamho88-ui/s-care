# Separate Railway service, same backend source. Never apply to the existing backend.
SPRING_PROFILES_ACTIVE=cloud
DEMO_ACCESS_ENABLED=false
DEMO_DEPLOYMENT_ENV=isolated-demo
DEMO_ACCESS_EXPIRES_AT=
DEMO_ALLOWED_ORIGIN=https://your-approved-demo-domain.example
DEMO_GATEWAY_KEY=
DEMO_CONTROL_KEY=
# Provision this role/schema beforehand; it must not own or access the existing brain schema.
DB_URL=jdbc:postgresql://your-session-pooler:5432/postgres?sslmode=require
DB_USER=brain_demo_showcase
DB_PASSWORD=
DB_SCHEMA=brain_demo_showcase
ADMIN_TOKEN=
GRAPH_NAMESPACE=Demo_showcase
NEO4J_URI=bolt://your-neo4j-private-host:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
GRAPH_REQUIRED=true
HERMES_PUBLISH_MODE=disabled
HERMES_URL=http://your-hermes-private-host:8642/v1
HERMES_API_KEY=
LOCAL_JEV_URL=http://your-jevos-private-host:8017/v1/systemone
JEV_PROVIDER=LOCAL
