# Local-only fictional demo credentials. Change ADMIN_TOKEN if sharing the machine.
ADMIN_TOKEN=local-demo-admin-change-me
DB_PASSWORD=brain_demo_only
NEO4J_PASSWORD=neo4j_demo_only
JEV_PROVIDER=LOCAL
# Host development default. Compose uses LOCAL_JEV_COMPOSE_URL instead.
LOCAL_JEV_URL=http://127.0.0.1:8017/v1/systemone
# For jevos running on the host instead:
# LOCAL_JEV_URL=http://host.docker.internal:8017/v1/systemone
LOCAL_JEV_KEY=
TYPESAFE_API_KEY=
JEV_TIMEOUT_SECONDS=30
STEP_MS=0
# Keep existing two-request Jev analysis only for controlled paired comparisons.
JEV_COMBINED_ANALYSIS=true
PARALLEL_ANALYSIS=true
# Spring Boot -> Nous Hermes (host development default)
HERMES_URL=http://127.0.0.1:8642/v1
# Generated by scripts/configure_hermes.py; use the same value as Hermes API_SERVER_KEY
HERMES_API_KEY=
HERMES_TIMEOUT_SECONDS=90
HERMES_SKILLS_DIR=
HERMES_PUBLISH_MODE=filesystem
# Optional remote approved-Skill bridge (separate from official Hermes API).
HERMES_PUBLISH_URL=
HERMES_PUBLISH_KEY=
# Hermes -> OpenAI. Never commit the actual key. Model can be changed later.
OPENAI_API_KEY=
HERMES_LLM_MODEL=gpt-4.1-mini

# Anonymous access is disabled by default. See docs/DEMO_ACCESS_SETUP.md.
DEMO_ACCESS_ENABLED=false
DEMO_ACCESS_EXPIRES_AT=
